# Clé API que votre app mobile devra envoyer dans le header "x-api-key"
# Générez une longue chaîne aléatoire, ex: openssl rand -hex 32
API_KEY=change_moi_avec_une_valeur_aleatoire_longue

# Identifiants du NOUVEAU compte FTP (dédié, droits limités si possible)
FTP_HOST=ftp.votre-domaine.com
FTP_USER=votre_utilisateur_ftp
FTP_PASS=votre_mot_de_passe_ftp
FTP_SECURE=true

# Dossier distant où déposer les images (doit déjà exister sur le FTP)
FTP_REMOTE_DIR=/images
